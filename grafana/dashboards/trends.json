    "list": [
      {
        "type": "query",
        "name": "last_month",
        "label": "Last full month",
        "description": "Feeds the links to the Ledger; not shown.",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "finflow-marts"
        },
        "query": "select to_char(max(month_start), 'YYYY-MM-DD') as __value, to_char(max(month_start), 'Mon YYYY') as __text from marts.fct_month_plan where is_complete_month",
        "definition": "select to_char(max(month_start), 'YYYY-MM-DD') as __value, to_char(max(month_start), 'Mon YYYY') as __text from marts.fct_month_plan where is_complete_month",
        "refresh": 1,
