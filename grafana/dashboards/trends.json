    {
      "id": 6,
      "type": "table",
      "title": "Months in numbers",
      "description": "The figures behind the chart above: income received and each bucket as a share of it. Shares add up to 100%; unallocated is below zero when more left chequing than came in.",
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 24,
        "h": 10
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "finflow-marts"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "finflow-marts"
          },
          "format": "table",
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "select\n  to_char(s.month_start, 'Mon YYYY') || case when s.is_complete_month then '' else ' (so far)' end as \"Month\",\n  s.spendable_income as \"Income\",\n  s.needs_pct as \"Needs\",\n  s.wants_pct as \"Wants\",\n  s.financial_future_pct as \"Financial future\",\n  s.unallocated_pct as \"Unallocated\"\nfrom marts.fct_monthly_summary s\norder by s.month_start desc\nlimit 13"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "–",
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^(Needs|Wants|Financial future|Unallocated)$"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "noValue",
                "value": "–"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Income"
            },
            "properties": [
              {
                "id": "unit",
                "value": "prefix:$"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      }
    },
    {
      "id": 3,
      "type": "table",
      "title": "Average bucket shares",
      "description": "Each bucket as a share of income over the last 3, 6 and 12 full months, next to its target. A period shows a dash until that many full months exist.",
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 24,
        "h": 6
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "finflow-marts"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "finflow-marts"
          },
          "format": "table",
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "select \"Period\", \"Needs\", \"Wants\", \"Financial future\", \"Unallocated\"\nfrom (\n  select r.window_months as ord,\n    'Last ' || r.window_months || ' full months' as \"Period\",\n    r.needs_pct as \"Needs\", r.wants_pct as \"Wants\",\n    r.financial_future_pct as \"Financial future\", r.unallocated_pct as \"Unallocated\"\n  from marts.fct_month_rolling r\n  where r.month_start = (select max(month_start) from marts.fct_month_plan where is_complete_month)\n  union all\n  select 99, 'Target', s.needs_target_pct, s.wants_target_pct, s.financial_future_target_pct, null\n  from marts.fct_monthly_summary s\n  where s.month_start = (select max(month_start) from marts.fct_month_plan)\n) t\norder by ord"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^(Needs|Wants|Financial future|Unallocated)$"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "noValue",
                "value": "–"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      }
    },
    {
      "id": 4,
      "type": "table",
      "title": "Wants by category and month",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "finflow-marts"
      },
      "description": "The last 12 full months, newest first: what each wants category cost. Colour compares a category with its own months, so a darker cell is a heavier month for that category. Click an amount for its line items.",
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "finflow-marts"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "select\n  to_char(c.month_start, 'YYYY-MM') as month,\n  c.category_name as category,\n  sum(c.spend) as spend\nfrom marts.fct_subcategory_month c\njoin marts.fct_month_plan p using (month_start)\nwhere p.is_complete_month and c.bucket = 'wants'\n  and c.month_start > (select max(month_start) from marts.fct_month_plan where is_complete_month) - interval '12 months'\ngroup by c.month_start, c.category_name\nhaving sum(c.spend) <> 0\norder by sum(sum(c.spend)) over (partition by c.category_name) desc, 2, 1"
        }
      ],
      "transformations": [
        {
          "id": "groupingToMatrix",
          "options": {
            "columnField": "category",
            "rowField": "month",
            "valueField": "spend",
            "emptyValue": "null"
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [
              {
                "field": "month\\category",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "prefix:$",
          "decimals": 0,
          "noValue": "–",
          "min": 0,
          "fieldMinMax": true,
          "color": {
            "mode": "continuous-blues"
          },
          "custom": {
