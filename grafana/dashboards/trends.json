  "uid": "finflow-trends",
  "title": "Trends",
  "description": "How complete months compare: each bucket as a share of income, and the income itself.",
  "time": {
    "from": "now-1y",
    "to": "now"
  },
  "timepicker": {
    "hidden": true
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "barchart",
      "title": "Buckets by month",
      "description": "The last 12 complete months. Each bucket as a share of that month's income; unallocated is what stayed in chequing, below zero when more went out than came in.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 11
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "finflow-marts"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "finflow-marts"
          },
          "format": "table",
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "select\n  to_char(s.month_start, 'Mon YYYY') as month,\n  s.needs_pct as \"Needs\",\n  s.wants_pct as \"Wants\",\n  s.financial_future_pct as \"Financial future\",\n  s.unallocated_pct as \"Unallocated\"\nfrom (\n  select s.*\n  from marts.fct_monthly_summary s\n  join marts.fct_month_plan p using (month_start)\n  where p.is_complete_month and s.spendable_income > 0\n  order by s.month_start desc\n  limit 12\n) s\norder by s.month_start"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 0,
          "custom": {
            "fillOpacity": 100,
            "lineWidth": 0
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Needs"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#3987e5"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Wants"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#d95926"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Financial future"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#7a5cc7"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Unallocated"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#898781"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "xField": "month",
        "orientation": "vertical",
        "stacking": "normal",
        "showValue": "auto",
        "barWidth": 0.6,
        "groupWidth": 0.7,
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 2,
      "type": "barchart",
      "title": "Income by month",
      "description": "The same months: income that reached chequing.",
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "finflow-marts"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "finflow-marts"
          },
          "format": "table",
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "select\n  to_char(s.month_start, 'Mon YYYY') as month,\n  s.spendable_income as \"Income\"\nfrom (\n  select s.*\n  from marts.fct_monthly_summary s\n  join marts.fct_month_plan p using (month_start)\n  where p.is_complete_month and s.spendable_income > 0\n  order by s.month_start desc\n  limit 12\n) s\norder by s.month_start"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "prefix:$",
          "decimals": 0,
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "#0ca30c"
          },
          "custom": {
            "fillOpacity": 100,
            "lineWidth": 0
          }
        },
        "overrides": []
      },
      "options": {
        "xField": "month",
        "orientation": "vertical",
        "stacking": "none",
        "showValue": "auto",
        "barWidth": 0.6,
        "groupWidth": 0.7,
        "legend": {
          "showLegend": false,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    }
  ]
}
