    {
      "id": 5,
      "type": "table",
      "title": "Biggest changes last month, by category",
      "description": "The last full month against the mean of the 3 full months before it, by category, largest change first. A positive change is more spending. Click a category for its line items.",
      "gridPos": {
        "x": 0,
        "y": 45,
        "w": 12,
        "h": 10
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "finflow-marts"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "finflow-marts"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "select\n  c.category_name as \"Category\",\n  initcap(c.bucket) as \"Bucket\",\n  sum(c.spend) as \"Last full month\",\n  sum(c.spend_avg_3m) as \"Mean of previous 3\",\n  sum(c.spend) - sum(c.spend_avg_3m) as \"Change\"\nfrom marts.fct_subcategory_month c\nwhere c.month_start = (select max(month_start) from marts.fct_month_plan where is_complete_month)\n  and c.baseline_months > 0\ngroup by c.bucket, c.category_name\nhaving sum(c.spend) - sum(c.spend_avg_3m) <> 0\norder by abs(sum(c.spend) - sum(c.spend_avg_3m)) desc\nlimit 10"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "prefix:$",
          "decimals": 0,
          "noValue": "–",
          "custom": {
            "align": "auto",
            "cellOptions": {
