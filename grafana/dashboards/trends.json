  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Income and where it went",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "finflow-marts"
      },
      "description": "The last 12 full months and this month so far. Bars: what left chequing as needs, wants and financial future. Line: the income received. Where the line sits above the bar, the gap is unallocated cash; a bar above the line means more left chequing than came in, paid from money already there.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 11
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "finflow-marts"
          },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "select\n  s.month_start::timestamp at time zone 'America/Toronto' as time,\n  s.needs_spend as \"Needs\",\n  s.wants_spend as \"Wants\",\n  s.financial_future as \"Financial future\",\n  s.spendable_income as \"Income\"\nfrom (\n  select s.*\n  from marts.fct_monthly_summary s\n  order by s.month_start desc\n  limit 13\n) s\norder by s.month_start"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "prefix:$",
          "decimals": 0,
          "custom": {
            "drawStyle": "bars",
            "barAlignment": 0,
            "barWidthFactor": 0.6,
            "fillOpacity": 100,
            "lineWidth": 0,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "axisLabel": ""
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Needs"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#3987e5"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Wants"
            },
            "properties": [
              {
                "id": "color",
