                    "title": "See the line items",
                    "url": "/d/finflow-ledger?var-month=${__data.fields[0]}-01&var-bucket=Wants&var-category=${__field.name:percentencode}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "month\\category"
