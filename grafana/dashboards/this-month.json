    {
      "id": 6,
      "type": "barchart",
      "title": "Where wants went this month",
      "description": "Wants by category. A category is listed when it has spend this month or in at least 2 of the previous 3 full months, so a one-off does not show up as usual.",
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 24,
        "h": 10
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "finflow-marts"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "finflow-marts"
          },
          "format": "table",
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "with cur as (\n  select category_name, sum(spend) as spend,\n    sum(spend_to_date_avg_3m) as to_date, sum(spend_avg_3m) as whole\n  from marts.fct_subcategory_month\n  where month_start = '${month}' and bucket = 'wants'\n  group by category_name\n), base as (\n  select s.category_name, count(distinct s.month_start) as months_with_spend\n  from marts.fct_subcategory_month s\n  join marts.fct_month_plan p using (month_start)\n  where s.bucket = 'wants' and s.spend > 0 and p.is_complete_month\n    and s.month_start >= ('${month}'::date - interval '3 months')\n    and s.month_start < '${month}'::date\n  group by s.category_name\n)\nselect\n  c.category_name as category,\n  c.spend as \"This month so far\",\n  c.to_date as \"Mean of previous 3 full months, by this day\",\n  c.whole as \"Mean of previous 3 full months, whole month\"\nfrom cur c\nleft join base b using (category_name)\nwhere c.spend > 0 or coalesce(b.months_with_spend, 0) >= 2\norder by 2 desc, 4 desc nulls last, 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "prefix:$",
          "decimals": 0,
          "min": 0,
          "custom": {
            "fillOpacity": 100,
            "lineWidth": 0,
            "axisLabel": ""
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "This month so far"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#d95926"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Mean of previous 3 full months, by this day"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#898781"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Mean of previous 3 full months, whole month"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#898781"
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 35
              }
            ]
          }
        ]
      },
      "options": {
        "orientation": "horizontal",
        "xField": "category",
        "showValue": "never",
        "groupWidth": 0.7,
        "barWidth": 0.9,
        "barRadius": 0.1,
        "stacking": "none",
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Buckets by month",
      "description": "Complete months. Bars: each bucket as a share of that month's income; unallocated is what stayed in chequing, below zero when more went out than came in. Line: the month's income (right axis).",
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 24,
        "h": 10
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "finflow-marts"
      },
      "timeFrom": "12M",
      "hideTimeOverride": true,
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "finflow-marts"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "select\n  ((s.month_start + 14)::timestamp at time zone 'America/Toronto') as time,\n  s.needs_pct as \"Needs\",\n  s.wants_pct as \"Wants\",\n  s.financial_future_pct as \"Financial future\",\n  s.unallocated_pct as \"Unallocated\",\n  s.spendable_income as \"Income\"\nfrom marts.fct_monthly_summary s\njoin marts.fct_month_plan p using (month_start)\nwhere p.is_complete_month and s.spendable_income > 0\norder by 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 0,
          "custom": {
            "drawStyle": "bars",
            "barAlignment": 0,
            "barWidthFactor": 0.6,
            "lineWidth": 0,
            "fillOpacity": 100,
            "showPoints": "never",
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "axisLabel": ""
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Needs"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#3987e5"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Wants"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#d95926"
                }
              }
            ]
          },
          {
