{
  "uid": "finflow-month",
  "title": "This month",
  "description": "Daily check: each bucket's share of income against its target, and spending so far against the previous months.",
  "tags": [
    "finflow"
  ],
  "timezone": "America/Toronto",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "time": {
    "from": "now/M",
    "to": "now/M"
  },
  "timepicker": {},
  "refresh": "",
  "links": [
    {
      "type": "dashboards",
      "title": "FinFlow dashboards",
      "tags": [
        "finflow"
      ],
      "asDropdown": false,
      "includeVars": false,
      "keepTime": false,
      "targetBlank": false,
      "icon": "external link"
    }
  ],
  "templating": {
    "list": [
      {
        "type": "query",
        "name": "month",
        "label": "Month",
        "description": "The month every panel shows.",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "finflow-marts"
        },
        "query": "select to_char(month_start, 'YYYY-MM-DD') as __value, to_char(month_start, 'Mon YYYY') as __text from marts.fct_month_plan order by month_start desc",
        "definition": "select to_char(month_start, 'YYYY-MM-DD') as __value, to_char(month_start, 'Mon YYYY') as __text from marts.fct_month_plan order by month_start desc",
        "refresh": 1,
        "sort": 0,
        "multi": false,
        "includeAll": false,
        "current": {},
        "options": [],
        "hide": 0
      },
      {
        "type": "custom",
        "name": "income_base",
        "label": "Bucket shares of",
        "description": "What the bucket shares divide by. A complete month uses its actual income either way.",
        "query": "Expected income : expected,Income received so far : received",
        "current": {
          "text": "Expected income",
          "value": "expected",
          "selected": true
        },
        "options": [
          {
            "text": "Expected income",
            "value": "expected",
            "selected": true
          },
          {
            "text": "Income received so far",
            "value": "received",
            "selected": false
          }
        ],
        "multi": false,
        "includeAll": false,
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Status",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "finflow-marts"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "finflow-marts"
          },
          "format": "table",
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "select\n  case\n    when p.as_of_day = 0 then 'Not started'\n    when p.is_complete_month then 'Complete month · shares are of the income received'\n    else 'Day ' || p.as_of_day || ' of ' || p.days_in_month || ' · ' ||\n      case\n        when p.spendable_income_expected is null then 'no expected income yet (no full month before this one)'\n        when p.spendable_income >= p.spendable_income_baseline then\n          'income received is already above the ' || b.label || ', so it is the expected income'\n        else 'income received: ' || round(p.income_received_share * 100) || '% of expected (the ' || b.label || ')'\n      end\n  end as status\nfrom marts.fct_month_plan p\ncross join lateral (\n  select case p.baseline_months\n    when 1 then 'previous full month'\n    else 'mean of the previous ' || p.baseline_months || ' full months'\n  end as label\n) b\nwhere p.month_start = '${month}'"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "noValue": "No data for this month"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/^status$/"
        },
        "textMode": "value",
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "text": {
          "valueSize": 20
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Wants left",
      "description": "Wants target (its share of expected income) minus wants spent so far. Per remaining day counts today.",
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 6,
        "h": 7
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "finflow-marts"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "finflow-marts"
          },
          "format": "table",
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "select label, amount\nfrom (\n  select 1 as ord,\n    case when p.is_complete_month then 'Wants left at month end' else 'Wants left' end as label,\n    p.wants_plan - s.wants_spend as amount\n  from marts.fct_month_plan p\n  join marts.fct_monthly_summary s using (month_start)\n  where month_start = '${month}'\n  union all\n  select 2, '≈ per remaining day',\n    round((p.wants_plan - s.wants_spend) / (p.days_in_month - greatest(p.as_of_day, 1) + 1), 2)\n  from marts.fct_month_plan p\n  join marts.fct_monthly_summary s using (month_start)\n  where month_start = '${month}' and not p.is_complete_month\n) t\norder by ord"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "prefix:$",
          "decimals": 0,
          "noValue": "No baseline yet",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#d03b3b",
                "value": null
              },
              {
                "color": "text",
                "value": 0
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": true,
          "calcs": [],
          "fields": "/^amount$/"
        },
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "horizontal"
      }
    },
    {
      "id": 3,
      "type": "table",
      "title": "Buckets vs targets",
      "description": "Each bucket so far as a share of income, against its target. Expected income is the larger of income received so far and the mean of the previous 3 full months; switch 'Bucket shares of' at the top to divide by income received so far. Needs and wants targets are ceilings. The financial future target is a floor, due by month end.",
      "gridPos": {
        "x": 6,
        "y": 3,
        "w": 18,
        "h": 7
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "finflow-marts"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "finflow-marts"
          },
          "format": "table",
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "with p as (\n  select * from marts.fct_month_plan where month_start = '${month}'\n), s as (\n  select * from marts.fct_monthly_summary where month_start = '${month}'\n), i as (\n  select nullif(case when '${income_base}' = 'received' then p.spendable_income\n                     else p.spendable_income_expected end, 0) as income\n  from p\n), b as (\n  select 1 as ord, 'Needs' as bucket, s.needs_spend as used, s.needs_target_pct as target from s\n  union all\n  select 2, 'Wants', s.wants_spend, s.wants_target_pct from s\n  union all\n  select 3, 'Financial future', s.financial_future, s.financial_future_target_pct from s\n)\nselect\n  b.bucket as \"Bucket\",\n  b.used as \"So far\",\n  round(b.used / i.income, 4) as \"% of income\",\n  b.target as \"Target\",\n  case\n    when i.income is null then 'no income'\n    when b.bucket = 'Financial future' then\n      case\n        when b.used / i.income >= b.target then '✓ target met'\n        when p.is_complete_month then '▼ below target'\n        else 'due by month end'\n      end\n    when b.used / i.income > b.target then '▲ over target'\n    else '● within target'\n  end as \"Status\"\nfrom b\ncross join p\ncross join i\norder by b.ord"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          },
          "unit": "prefix:$",
          "decimals": 2
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "% of income"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "noValue",
                "value": "–"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Target"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Status"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "thresholds"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "transparent",
                      "value": null
                    }
                  ]
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "▲ over target": {
                        "color": "#d03b3b",
                        "index": 0
                      },
                      "▼ below target": {
                        "color": "#d03b3b",
                        "index": 1
                      },
                      "● within target": {
                        "color": "#0ca30c",
                        "index": 2
                      },
                      "✓ target met": {
                        "color": "#0ca30c",
                        "index": 3
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Wants by day",
      "description": "Wants added up day by day. The line is red where it runs above the mean of the previous 3 full months on the same day of the month.",
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "finflow-marts"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "finflow-marts"
          },
          "format": "table",
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "with d as (\n  select date_day, month_start, amount_mtd, pace_mtd_avg_3m,\n    coalesce(amount_mtd > pace_mtd_avg_3m, false) as above,\n    coalesce(lead(amount_mtd > pace_mtd_avg_3m) over (order by date_day), false) as above_next\n  from marts.fct_pace_day\n  where month_start = '${month}' and series = 'wants'\n)\nselect\n  (d.date_day::timestamp at time zone 'America/Toronto') as time,\n  case when not d.above or not d.above_next then d.amount_mtd end as \"This month\",\n  case when d.above or d.above_next then d.amount_mtd end as \"This month, above the mean\",\n  d.pace_mtd_avg_3m as \"Mean of previous 3 full months, by this day\",\n  p.wants_plan as \"Wants target for the month\"\nfrom d\njoin marts.fct_month_plan p using (month_start)\norder by 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "prefix:$",
          "decimals": 0,
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false,
            "axisLabel": ""
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "This month"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#0ca30c"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "This month, above the mean"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#d03b3b"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Mean of previous 3 full months, by this day"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#898781"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Wants target for the month"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#d95926"
                }
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Everyday needs by day",
      "description": "Needs that are not recurring bills, added up day by day. The line is red where it runs above the mean of the previous 3 full months on the same day of the month.",
      "gridPos": {
        "x": 12,
        "y": 10,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "finflow-marts"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "finflow-marts"
          },
          "format": "table",
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "with d as (\n  select date_day, month_start, amount_mtd, pace_mtd_avg_3m,\n    coalesce(amount_mtd > pace_mtd_avg_3m, false) as above,\n    coalesce(lead(amount_mtd > pace_mtd_avg_3m) over (order by date_day), false) as above_next\n  from marts.fct_pace_day\n  where month_start = '${month}' and series = 'variable_needs'\n)\nselect\n  (d.date_day::timestamp at time zone 'America/Toronto') as time,\n  case when not d.above or not d.above_next then d.amount_mtd end as \"This month\",\n  case when d.above or d.above_next then d.amount_mtd end as \"This month, above the mean\",\n  d.pace_mtd_avg_3m as \"Mean of previous 3 full months, by this day\"\nfrom d\norder by 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "prefix:$",
          "decimals": 0,
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
