  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "This selection",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "finflow-marts"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "description": "Your own spending for the month or period, bucket and category chosen at the top. Expenses another person paid are left out, as on the other dashboards.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "finflow-marts"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "select coalesce(sum(amount), 0) as \"Spent\", coalesce(sum(amount), 0) / greatest(${span}, 1) as \"Per month\", count(*) as \"Line items\"\nfrom marts.fct_transactions\nwhere type = 'expense' and is_self_funded\n  and month_start >= '${month}'::date - make_interval(months => ${span})\n  and month_start < '${month}'::date + case when ${span} = 0 then interval '1 month' else interval '0' end\n  and ('${bucket}' = 'all' or initcap(bucket) = '${bucket}')\n  and (${category:sqlstring} = 'all' or category_name = ${category:sqlstring})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "decimals": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^(Spent|Per month)$"
            },
            "properties": [
              {
                "id": "unit",
                "value": "prefix:$"
              },
              {
                "id": "decimals",
                "value": 2
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "orientation": "vertical",
        "text": {
          "titleSize": 15,
          "valueSize": 30
        }
      }
    },
    {
      "id": 2,
      "type": "table",
      "title": "By subcategory",
      "description": "Each subcategory in the selection, largest first. Per month divides by the number of months in the period.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "finflow-marts"
      },
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "finflow-marts"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "select\n  category_name as \"Category\",\n  subcategory_name as \"Subcategory\",\n  initcap(bucket) as \"Bucket\",\n  sum(amount) as \"Spent\",\n  sum(amount) / greatest(${span}, 1) as \"Per month\",\n  count(*) as \"Line items\"\nfrom marts.fct_transactions\nwhere type = 'expense' and is_self_funded\n  and month_start >= '${month}'::date - make_interval(months => ${span})\n  and month_start < '${month}'::date + case when ${span} = 0 then interval '1 month' else interval '0' end\n  and ('${bucket}' = 'all' or initcap(bucket) = '${bucket}')\n  and (${category:sqlstring} = 'all' or category_name = ${category:sqlstring})\ngroup by 1, 2, 3\norder by 4 desc, 1, 2"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "prefix:$",
          "decimals": 0,
          "noValue": "–",
          "custom": {
            "align": "auto",
            "filterable": false,
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^(Date|Item|Merchant|Category|Subcategory|Bucket|Note|Month)$"
            },
            "properties": [
              {
                "id": "unit",
                "value": "none"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Line items"
            },
            "properties": [
              {
                "id": "unit",
                "value": "none"
              },
              {
                "id": "custom.width",
                "value": 95
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Bucket"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 75
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Spent"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 95
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Per month"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 100
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      }
    },
    {
      "id": 4,
      "type": "barchart",
      "title": "This bucket and category by month",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "finflow-marts"
      },
      "gridPos": {
        "x": 12,
        "y": 3,
        "w": 12,
        "h": 9
      },
      "description": "Your own spending in the chosen bucket and category for each of the last 12 full months and this month so far, whatever period is selected. It shows whether a figure is a one-off or a habit.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "finflow-marts"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "select\n  to_char(p.month_start, 'Mon YY') || case when p.is_complete_month then '' else ' (so far)' end as month,\n  coalesce(sum(f.amount), 0) as \"Spent\"\nfrom (select * from marts.fct_month_plan order by month_start desc limit 13) p\nleft join (\n  select month_start, amount from marts.fct_transactions\n  where type = 'expense' and is_self_funded\n    and ('${bucket}' = 'all' or initcap(bucket) = '${bucket}')\n  and (${category:sqlstring} = 'all' or category_name = ${category:sqlstring})\n) f on f.month_start = p.month_start\ngroup by p.month_start, p.is_complete_month\norder by p.month_start"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "prefix:$",
          "decimals": 0,
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "#3987e5"
          },
          "custom": {
            "fillOpacity": 100,
            "lineWidth": 0
          }
        },
        "overrides": []
      },
      "options": {
        "xField": "month",
        "orientation": "vertical",
        "stacking": "none",
        "showValue": "auto",
        "barWidth": 0.6,
        "groupWidth": 0.7,
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      }
    },
    {
      "id": 3,
      "type": "table",
      "title": "Line items",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "finflow-marts"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 24,
        "h": 14
      },
      "description": "Every line in the selection, largest first. Use the funnel on a column header to narrow further, for example to one subcategory.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "finflow-marts"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "select\n  to_char(occurred_on, 'YYYY-MM-DD') as \"Date\",\n  coalesce(item_description, description) as \"Item\",\n  coalesce(merchant_name, venue_name) as \"Merchant\",\n  category_name as \"Category\",\n  subcategory_name as \"Subcategory\",\n  initcap(bucket) as \"Bucket\",\n  amount as \"Amount\",\n  notes as \"Note\"\nfrom marts.fct_transactions\nwhere type = 'expense' and is_self_funded\n  and month_start >= '${month}'::date - make_interval(months => ${span})\n  and month_start < '${month}'::date + case when ${span} = 0 then interval '1 month' else interval '0' end\n  and ('${bucket}' = 'all' or initcap(bucket) = '${bucket}')\n  and (${category:sqlstring} = 'all' or category_name = ${category:sqlstring})\norder by amount desc, occurred_on desc, line_key"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "–",
          "custom": {
            "align": "auto",
            "filterable": true,
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Amount"
            },
            "properties": [
              {
                "id": "unit",
                "value": "prefix:$"
              },
              {
                "id": "decimals",
                "value": 2
              },
              {
                "id": "custom.width",
                "value": 110
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Date"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 110
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Bucket"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 90
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Item"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 300
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Merchant"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 150
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
