          {
            "matcher": {
              "id": "byName",
              "options": "Subcategory"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 210
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
