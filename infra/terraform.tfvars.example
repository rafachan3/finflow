# Copy to terraform.tfvars (gitignored) and fill in your address:
#
#   cp terraform.tfvars.example terraform.tfvars
#
budget_alert_email = "you@example.com"

# Supabase organization slug (dashboard URL: supabase.com/dashboard/org/<slug>)
supabase_organization_id = "your-org-slug"

# Must match the GitHub repo that assumes the ingest OIDC deploy role (owner/name).
github_repository = "your-github-user/finflow"
