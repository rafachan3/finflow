{
  "name": "finflow-ingest",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "eval": "node eval/run.mjs",
    "db:up": "docker run -d --rm --name finflow-test-db -e POSTGRES_PASSWORD=postgres -p 127.0.0.1:54329:5432 postgres:17",
    "db:down": "docker stop finflow-test-db",
    "build": "tsc --noEmit",
    "bundle": "esbuild src/handler.ts --bundle --platform=node --target=node22 --outfile=dist/index.js --format=cjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1120.0",
    "@aws-sdk/client-ssm": "^3.800.0",
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.149",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.0",
    "aws-sdk-client-mock": "^4.1.0",
    "esbuild": "^0.25.0",
    "msw": "^2.15.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  }
}
