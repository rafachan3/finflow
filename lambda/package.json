{
  "name": "finflow-ingest",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:coverage": "vitest run --coverage",
    "eval": "node eval/run.mjs",
    "eval:buckets": "vite-node eval/buckets-cli.ts --",
    "db:up": "node scripts/test-db.mjs up",
    "db:down": "node scripts/test-db.mjs down",
    "db:url": "node scripts/test-db.mjs url",
    "build": "tsc --noEmit",
    "backfill:media-merchant": "esbuild scripts/backfill-media-merchant.ts --bundle --platform=node --target=node22 --format=esm --packages=external --outfile=dist/backfill-media-merchant.mjs && node dist/backfill-media-merchant.mjs",
    "telegram:commands": "esbuild scripts/set-commands.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/set-commands.mjs && node dist/set-commands.mjs",
    "bundle":"esbuild src/handler.ts --bundle --platform=node --target=node22 --outfile=dist/index.js --format=cjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1120.0",
    "@aws-sdk/client-ssm": "^3.800.0",
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.149",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.0",
    "@vitest/coverage-v8": "^4.1.12",
    "aws-sdk-client-mock": "^4.1.0",
    "esbuild": "^0.25.0",
    "msw": "^2.15.0",
    "typescript": "^5.8.0",
    "vitest": "^4.1.12"
  }
}
